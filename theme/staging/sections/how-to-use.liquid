{%- liquid
  assign modifier = ''
  if section.settings.mobile_display == 'swipe'
    assign modifier = ' how-to--swipe'
  endif
-%}

{{ 'how-to-use.css' | asset_url | stylesheet_tag }}

<section
  class="section how-to{{ modifier }}"
  style="
    background: {{ section.settings.background }};
    --how-to-ratio: {{ section.settings.media_ratio }};
    --how-to-columns: {{ section.blocks.size | at_most: 4 }};
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header text-center reveal reveal--up">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="how-to__steps">
      {%- for block in section.blocks -%}
        {%- liquid
          comment
            Pick a rendition that suits a card a few hundred pixels wide rather
            than the largest one, which would be several megabytes per step.
          endcomment
          assign mp4s = block.settings.video.sources | where: 'format', 'mp4' | sort: 'width'
          assign clip = mp4s | last
          for source in mp4s
            if source.width <= 720
              assign clip = source
            endif
          endfor

          comment
            Animated GIFs are served untransformed, because a resize can flatten
            them to a single frame.
          endcomment
          assign is_gif = false
          if block.settings.image.src contains '.gif'
            assign is_gif = true
          endif

          assign delay = forloop.index0 | times: 90
        -%}
        <li
          class="how-to__step reveal reveal--up"
          style="--reveal-delay: {{ delay }}ms;"
          {{ block.shopify_attributes }}
        >
          <div class="how-to__media">
            {%- if clip != blank -%}
              <video
                src="{{ clip.url }}"
                poster="{{ block.settings.video.preview_image | image_url: width: 800 }}"
                loop
                muted
                playsinline
                preload="metadata"
                disableremoteplayback
                aria-label="{{ block.settings.title | escape }}"
              ></video>
            {%- elsif block.settings.image != blank -%}
              {%- if is_gif -%}
                <img
                  src="{{ block.settings.image.src }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- else -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 30vw, 78vw',
                    widths: '300, 450, 600, 750, 900',
                    alt: block.settings.image.alt | default: block.settings.title
                }}
              {%- endif -%}
            {%- else -%}
              <div class="how-to__placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
          </div>

          <div class="how-to__body">
            {%- if section.settings.show_numbers -%}
              <span class="how-to__num" aria-hidden="true">{{ forloop.index }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="how-to__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="how-to__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank -%}
      <div class="how-to__cta reveal reveal--up">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">
          {{ section.settings.button_label }}
          {%- render 'icon', name: 'arrow-right' -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var section = document.currentScript.previousElementSibling;
    var videos = section.querySelectorAll('.how-to__media video');
    if (!videos.length) return;

    // Autoplaying three clips at once costs bandwidth for steps nobody has
    // scrolled to yet, so each one starts only when it comes into view.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) {
      Array.prototype.forEach.call(videos, function (v) {
        var p = v.play(); if (p && p.catch) p.catch(function () {});
      });
      return;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var video = entry.target;
        if (entry.isIntersecting) {
          var played = video.play();
          if (played && played.catch) played.catch(function () {});
        } else if (!video.paused) {
          video.pause();
        }
      });
    }, { threshold: 0.35 });

    Array.prototype.forEach.call(videos, function (v) { observer.observe(v); });
  })();
</script>

{% schema %}
{
  "name": "How to use",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Three steps to a better night."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Optional. Keep it to one line — the steps do the explaining."
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Clip shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "16 / 9", "label": "Widescreen 16:9" },
        { "value": "9 / 16", "label": "Tall 9:16" }
      ],
      "default": "1 / 1",
      "info": "All three steps share one shape. Film them the same way and they will line up."
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show step numbers",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_display",
      "label": "On mobile",
      "options": [
        { "value": "stacked", "label": "Stacked — one step under the next" },
        { "value": "swipe", "label": "Swipe — steps side by side, scrolled" }
      ],
      "default": "stacked"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Optional. Leave empty to hide the button."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Clip",
          "info": "Best option. A short muted MP4 loop is a fraction of the size of a GIF at the same quality, and it starts only when the step scrolls into view."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image or GIF",
          "info": "Used when no clip is set. Animated GIFs are served at their original size, so keep them small."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>One sentence. Say what they do and what they should expect to see.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to use",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Open the box",
            "text": "<p>Your Pilo ships compressed and sealed, so the box is smaller than you expect. Slide it out and cut the tape.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Unwrap the pillow",
            "text": "<p>Cut the seal and let it breathe. It takes about an hour to expand to full shape.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Sleep on it",
            "text": "<p>Give it three nights. Your neck needs a few to unlearn the old pillow.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
