{%- liquid
  assign cols_class = ''
  if section.settings.columns == '2' and section.settings.collapsible != 'group'
    assign cols_class = ' specs--two-col'
  endif
-%}

{{ 'specs-table.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The rows, used as-is when nothing is collapsed and inside the single panel
  when the whole table is behind one toggle.
{%- endcomment -%}
{%- capture specs_list -%}
  <dl class="specs__list">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'group' -%}
          {%- if block.settings.title != blank -%}
            <div class="specs__group" {{ block.shopify_attributes }}>
              <span>{{ block.settings.title }}</span>
            </div>
          {%- endif -%}
        {%- when 'row' -%}
          {%- if block.settings.label != blank or block.settings.value != blank -%}
            <div class="specs__row" {{ block.shopify_attributes }}>
              <dt class="specs__label">{{ block.settings.label }}</dt>
              <dd class="specs__value">
                {{ block.settings.value }}
                {%- if block.settings.note != blank -%}
                  <span class="specs__note">{{ block.settings.note }}</span>
                {%- endif -%}
              </dd>
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </dl>
{%- endcapture -%}

<section
  class="section specs{{ cols_class }}"
  style="
    background: {{ section.settings.background }};
    --specs-width: {{ section.settings.max_width }}px;
    --specs-label: {{ section.settings.label_width }}fr;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="specs__header reveal reveal--up">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- case section.settings.collapsible -%}

      {%- when 'all' -%}
        {%- comment -%}
          One toggle over everything. The markup matches the FAQ accordion so
          the theme's existing [data-toggle] handler drives it.
        {%- endcomment -%}
        <div class="accordion specs__accordion reveal reveal--up">
          <div class="accordion__item">
            <button
              type="button"
              class="accordion__toggle"
              data-toggle
              aria-expanded="{% if section.settings.open_first %}true{% else %}false{% endif %}"
            >
              {{ section.settings.toggle_label | default: 'Specifications' }}
              {%- render 'icon', name: 'chevron-down' -%}
            </button>
            <div class="accordion__panel">
              <div>
                <div class="accordion__panel-inner">{{ specs_list }}</div>
              </div>
            </div>
          </div>
        </div>

      {%- when 'group' -%}
        {%- comment -%}
          One panel per group heading. Any rows placed before the first group
          have no panel to belong to, so they stay visible above the accordion.
        {%- endcomment -%}
        {%- assign seen_group = false -%}
        {%- capture loose_rows -%}
          {%- for block in section.blocks -%}
            {%- comment -%}
              A group with no title renders no panel, so it must not start one
              here either or the rows after it would vanish.
            {%- endcomment -%}
            {%- if block.type == 'group' and block.settings.title != blank -%}
              {%- assign seen_group = true -%}
            {%- elsif block.type == 'row' and seen_group == false -%}
              {%- if block.settings.label != blank or block.settings.value != blank -%}
                <div class="specs__row" {{ block.shopify_attributes }}>
                  <dt class="specs__label">{{ block.settings.label }}</dt>
                  <dd class="specs__value">
                    {{ block.settings.value }}
                    {%- if block.settings.note != blank -%}
                      <span class="specs__note">{{ block.settings.note }}</span>
                    {%- endif -%}
                  </dd>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if loose_rows != blank -%}
          <dl class="specs__list reveal reveal--up">{{ loose_rows }}</dl>
        {%- endif -%}

        <div class="accordion specs__accordion reveal reveal--up">
          {%- assign panel_open = false -%}
          {%- assign panel_index = 0 -%}
          {%- for block in section.blocks -%}

            {%- if block.type == 'group' and block.settings.title != blank -%}
              {%- if panel_open -%}
                    </dl>
                  </div>
                </div>
              </div>
            </div>
              {%- endif -%}
              {%- assign panel_index = panel_index | plus: 1 -%}
            <div class="accordion__item" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="accordion__toggle"
                data-toggle
                aria-expanded="{% if panel_index == 1 and section.settings.open_first %}true{% else %}false{% endif %}"
              >
                {{ block.settings.title }}
                {%- render 'icon', name: 'chevron-down' -%}
              </button>
              <div class="accordion__panel">
                <div>
                  <div class="accordion__panel-inner">
                    <dl class="specs__list">
              {%- assign panel_open = true -%}

            {%- elsif block.type == 'row' and panel_open -%}
              {%- if block.settings.label != blank or block.settings.value != blank -%}
                      <div class="specs__row" {{ block.shopify_attributes }}>
                        <dt class="specs__label">{{ block.settings.label }}</dt>
                        <dd class="specs__value">
                          {{ block.settings.value }}
                          {%- if block.settings.note != blank -%}
                            <span class="specs__note">{{ block.settings.note }}</span>
                          {%- endif -%}
                        </dd>
                      </div>
              {%- endif -%}
            {%- endif -%}

          {%- endfor -%}
          {%- if panel_open -%}
                    </dl>
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>

      {%- else -%}
        <div class="reveal reveal--up">{{ specs_list }}</div>

    {%- endcase -%}

    {%- if section.settings.footnote != blank -%}
      <p class="specs__footnote reveal reveal--up">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Specs table",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The details"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Specifications"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Optional line under the heading."
    },
    {
      "type": "header",
      "content": "Collapsing"
    },
    {
      "type": "select",
      "id": "collapsible",
      "label": "Collapse the table",
      "options": [
        { "value": "group", "label": "One panel per group" },
        { "value": "all", "label": "Whole table behind one toggle" },
        { "value": "off", "label": "Always open" }
      ],
      "default": "group",
      "info": "Collapsed panels open when the visitor presses the heading."
    },
    {
      "type": "text",
      "id": "toggle_label",
      "label": "Toggle label",
      "default": "Specifications",
      "info": "Only used when the whole table sits behind one toggle."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first panel by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "1", "label": "One column" },
        { "value": "2", "label": "Two columns" }
      ],
      "default": "1",
      "info": "Two columns suits long lists. Ignored when collapsing by group, and below 750px it is always one column."
    },
    {
      "type": "range",
      "id": "label_width",
      "label": "Label column width",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "info": "Relative to the value column, which is fixed at 6."
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 860
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "info": "Small print under the table, for tolerances or measuring notes."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Spec row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Value"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "info": "Optional, shown smaller under the value."
        }
      ]
    },
    {
      "type": "group",
      "name": "Group heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Group"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Specs table",
      "blocks": [
        { "type": "group", "settings": { "title": "Construction" } },
        { "type": "row", "settings": { "label": "Fill", "value": "Adaptive contour memory foam" } },
        { "type": "row", "settings": { "label": "Cover", "value": "Breathable cooling cover, zips off" } },
        { "type": "row", "settings": { "label": "Certification", "value": "OEKO-TEX® STANDARD 100" } },
        { "type": "group", "settings": { "title": "Fit" } },
        { "type": "row", "settings": { "label": "Sleeping position", "value": "Back and side" } },
        { "type": "row", "settings": { "label": "Dimensions", "value": "Add your measurement" } },
        { "type": "row", "settings": { "label": "Loft (height)", "value": "Add your measurement" } },
        { "type": "row", "settings": { "label": "Weight", "value": "Add your measurement" } },
        { "type": "group", "settings": { "title": "Care and delivery" } },
        { "type": "row", "settings": { "label": "Washing", "value": "Cover is machine washable" } },
        { "type": "row", "settings": { "label": "Delivery", "value": "Free across Lebanon, 1–5 days" } },
        { "type": "row", "settings": { "label": "Returns", "value": "Unopened and sealed only" } }
      ]
    }
  ]
}
{% endschema %}
