{%- comment -%}
  Product card for collection and search listings. Accepts: product.
{%- endcomment -%}

<a class="card" href="{{ product.url }}">
  <div class="card__media">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
        width="300" height="300" loading="lazy"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
  <div class="card__body">
    <span class="card__name">{{ product.title }}</span>
    <span class="card__cost">
      {%- if product.compare_at_price > product.price -%}
        <s>{{ product.compare_at_price | money }}</s>
      {%- endif -%}
      {{ product.price | money }}
    </span>
  </div>
</a>
