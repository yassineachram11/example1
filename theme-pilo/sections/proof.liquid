{%- comment -%}
  Customer quotes. Only put real ones here: an invented review is the fastest
  way to lose the trust the rest of the page is building.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.background }}; }
{%- endstyle -%}

<section class="band">
  <div class="wrap">
    <div class="band__head band__head--center rise">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="quotes">
      {%- for block in section.blocks -%}
        <figure class="quote rise" {{ block.shopify_attributes }}>
          {%- if block.settings.stars > 0 -%}
            <div class="stars" role="img" aria-label="{{ block.settings.stars }} out of 5">
              {%- for i in (1..5) -%}
                <span class="stars__s{% if forloop.index <= block.settings.stars %} is-on{% endif %}">
                  {%- render 'icon', name: 'star' -%}
                </span>
              {%- endfor -%}
            </div>
          {%- endif -%}
          <blockquote>{{ block.settings.text }}</blockquote>
          <figcaption>
            <span class="quote__who">{{ block.settings.name }}</span>
            {%- if block.settings.note != blank -%}
              <span class="quote__note">{{ block.settings.note }}</span>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer quotes",
  "tag": "section",
  "class": "section-proof",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In their words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say after a week" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F4F6F9" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "note", "label": "Detail", "info": "Where they are, or how long they have had it." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Customer quotes", "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }] }]
}
{% endschema %}
