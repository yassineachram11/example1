{%- style -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.background }}; }
{%- endstyle -%}

<section class="band">
  <div class="wrap">
    <div class="band__head band__head--center rise">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="lede rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <ol class="steps" role="list">
      {%- for block in section.blocks -%}
        <li class="step rise" {{ block.shopify_attributes }}>
          <span class="step__n" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="step__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="step__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Steps",
  "tag": "section",
  "class": "section-steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What happens next" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From order to first night" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F4F6F9" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "You order" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pick your pack and check out. Cash on delivery is fine." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Steps",
      "blocks": [
        { "type": "step", "settings": { "title": "You order", "text": "Pick your pack and check out. Cash on delivery is fine." } },
        { "type": "step", "settings": { "title": "We dispatch", "text": "Your pillow leaves us within one business day." } },
        { "type": "step", "settings": { "title": "It arrives", "text": "Free delivery anywhere in Lebanon, usually in one to five days." } }
      ]
    }
  ]
}
{% endschema %}
