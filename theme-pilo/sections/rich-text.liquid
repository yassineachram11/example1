{%- style -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.background }}; }
{%- endstyle -%}

<section class="band">
  <div class="wrap wrap--narrow rise" style="text-align: {{ section.settings.align }};">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte lede" style="margin-top: 14px;">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p class="band__cta" style="text-align: inherit;">
        <a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Text",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "About Pilo" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }],
      "default": "center"
    },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
