{%- comment -%}
  The last ask. It sends people back to the one buy box rather than rendering a
  second one, so there is never a pair of pack pickers disagreeing about what
  is in the cart.
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product | default: settings.hero_product
  assign v = product.selected_or_first_available_variant
-%}

{%- style -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.background }}; }
{%- endstyle -%}

<section class="band close">
  <div class="wrap wrap--narrow close__in rise">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h2 class="close__title">{{ section.settings.heading }}</h2>

    {%- if section.settings.text != blank -%}
      <div class="lede rte close__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if product != blank -%}
      <p class="close__price">
        {{ 'products.product.from' | t }} {{ v.price | money }}
      </p>
    {%- endif -%}

    <a class="btn btn--primary btn--lg" href="{{ section.settings.link | default: '#buy' }}">
      {{ section.settings.button_label }}
    </a>

    {%- if section.settings.note != blank -%}
      <p class="close__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Closing offer",
  "tag": "section",
  "class": "section-closing-offer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Leave the link empty and the button jumps back to the buy box at the top of the page."
    },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give your neck a better night" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Choose your pack" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Note under the button", "default": "Free delivery across Lebanon. Cash on delivery available." },
    { "type": "color", "id": "background", "label": "Background", "default": "#EAF0F7" }
  ],
  "presets": [{ "name": "Closing offer" }]
}
{% endschema %}
