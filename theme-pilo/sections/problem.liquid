{%- comment -%}
  Name the problem before selling the fix. A visitor who recognises themselves
  in one of these lines reads the rest of the page differently.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.background }}; }
{%- endstyle -%}

<section class="band">
  <div class="wrap">
    <div class="band__head band__head--center rise">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="lede rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <ul class="pains" role="list">
      {%- for block in section.blocks -%}
        <li class="pain rise" {{ block.shopify_attributes }}>
          <h3 class="pain__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="pain__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <p class="band__cta">
        <a class="btn btn--primary btn--lg" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Problem",
  "tag": "section",
  "class": "section-problem",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sound familiar?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most mornings start with a stiff neck" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "pain",
      "name": "Problem",
      "settings": [
        { "type": "text", "id": "title", "label": "Problem", "default": "You wake up sore" },
        { "type": "textarea", "id": "text", "label": "Detail", "default": "A flat pillow lets your head drop, so your neck holds the weight all night." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Problem",
      "blocks": [
        { "type": "pain", "settings": { "title": "You wake up sore", "text": "A flat pillow lets your head drop, so your neck holds the weight all night." } },
        { "type": "pain", "settings": { "title": "You keep flipping it", "text": "Fibre fill packs down within an hour and stops supporting anything." } },
        { "type": "pain", "settings": { "title": "It sleeps hot", "text": "Dense foam with no airflow traps heat right under your head." } }
      ]
    }
  ]
}
{% endschema %}
