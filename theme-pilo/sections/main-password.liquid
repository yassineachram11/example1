<section class="band" style="min-height: 70vh; display: grid; place-items: center;">
  <div class="wrap wrap--narrow" style="text-align: center;">
    {%- if settings.logo -%}
      <img
        src="{{ settings.logo | image_url: width: 600 }}"
        alt="{{ shop.name | escape }}"
        width="{{ settings.logo_w }}"
        style="width: {{ settings.logo_w }}px; height: auto; margin: 0 auto 24px;"
      >
    {%- else -%}
      <h1>{{ shop.name }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="lede rte" style="margin: 0 auto 26px;">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="cart-error" style="margin-bottom: 12px;">{{ form.errors.messages.form }}</p>
      {%- endif -%}
      <div class="search-form" style="max-width: 400px; margin: 0 auto;">
        <input type="password" name="password" placeholder="{{ 'general.password_page.password' | t }}" aria-label="Password">
        <button type="submit" class="btn btn--primary">{{ 'general.password_page.enter' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We are opening shortly.</p>" }
  ]
}
{% endschema %}
