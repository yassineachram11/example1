<section class="band band--tight">
  <div class="wrap">
    <h1>{{ page_title }}</h1>
    <div class="grid-cards" style="margin-top: 28px;">
      {%- for collection in collections -%}
        <a class="card" href="{{ collection.url }}">
          <div class="card__media">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.featured_image.alt | escape }}" width="300" height="300" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <div class="card__body">
            <span class="card__name">{{ collection.title }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Collections", "tag": "section", "class": "section-main-list-collections", "settings": [] }
{% endschema %}
