<section class="band band--tight">
  <div class="wrap" style="max-width: 460px;">
    <h1>{{ 'customer.recover.title' | t }}</h1>

    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="reset-password">{{ 'customer.login.password' | t }}</label>
        <input type="password" name="customer[password]" id="reset-password" autocomplete="new-password">
      </div>
      <div class="field">
        <label for="reset-confirm">{{ 'customer.login.password' | t }}</label>
        <input type="password" name="customer[password_confirmation]" id="reset-confirm" autocomplete="new-password">
      </div>
      <button type="submit" class="btn btn--primary btn--full">{{ 'customer.recover.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
